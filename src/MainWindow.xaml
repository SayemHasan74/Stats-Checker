<Window x:Class="PulseOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PulseOverlay"
 Title="Pulse Overlay" Width="1000" Height="850" MinWidth="820" MinHeight="650"
 Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <DrawingBrush x:Key="GridPattern" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
   <DrawingBrush.Drawing><GeometryDrawing Brush="#0B0C0F"><GeometryDrawing.Pen><Pen Brush="#202228" Thickness=".5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,28,28"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Background="#090A0C" Padding="20,16" Margin="0,0,0,16">
   <StackPanel>
    <DockPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="STARTING SENSORS" Foreground="#AAB0BA" FontSize="11"/><TextBlock Text="PULSE_OVERLAY / 1.1" Style="{StaticResource Caption}"/></DockPanel>
    <TextBlock Text="Performance, without the noise." FontSize="27" FontWeight="Bold" Margin="0,8,0,8"/>
    <TextBlock Text="Your game. Your numbers. Only what you need." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource GridPattern}" Height="162" Margin="0,0,0,16" Padding="14">
     <Grid>
      <Viewbox x:Name="PreviewBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top" MaxHeight="60"><local:MetricStrip x:Name="PreviewStrip"/></Viewbox>
      <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False"><TextBlock Text="LIVE PREVIEW" FontSize="10" Foreground="#C4C7CE"/><TextBlock Text="Actual readings · scales to fit this preview" FontSize="10" Foreground="#787E89" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </Border>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="// OVERLAY METRICS" FontWeight="Bold" FontSize="13"/>
        <TextBlock Text="Disabled collectors pause automatically." Style="{StaticResource Caption}" Margin="0,7,0,12"/>
        <UniformGrid Columns="2">
         <CheckBox Content="FPS" IsChecked="{Binding ShowFps}"/><CheckBox Content="CPU usage" IsChecked="{Binding ShowCpuUsage}"/>
         <CheckBox Content="CPU temperature" IsChecked="{Binding ShowCpuTemp}"/><CheckBox Content="GPU usage" IsChecked="{Binding ShowGpuUsage}"/>
         <CheckBox Content="GPU temperature" IsChecked="{Binding ShowGpuTemp}"/><CheckBox Content="RAM usage" IsChecked="{Binding ShowRam}"/>
         <CheckBox Content="VRAM usage" IsChecked="{Binding ShowVram}"/><CheckBox Content="Disk activity" IsChecked="{Binding ShowDisk}"/>
         <CheckBox Content="Network speed" IsChecked="{Binding ShowNetwork}"/><CheckBox Content="Clock" IsChecked="{Binding ShowClock}"/>
         <CheckBox Content="CPU clock" IsChecked="{Binding ShowCpuClock}"/><CheckBox Content="GPU clock" IsChecked="{Binding ShowGpuClock}"/>
         <CheckBox Content="CPU / GPU power" IsChecked="{Binding ShowPower}"/>
        </UniformGrid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="// BEHAVIOR" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
       <CheckBox Content="Show overlay" IsChecked="{Binding ShowOverlay}"/>
       <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
       <TextBlock Text="Closing settings keeps the overlay in the tray." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
      <TextBlock Text="// APPEARANCE" FontWeight="Bold" FontSize="13"/>
      <TextBlock Text="A quiet strip. Built around your game." Style="{StaticResource Caption}" Margin="0,7,0,20"/>
      <TextBlock Text="Screen position" Style="{StaticResource Caption}"/>
      <ComboBox SelectedValue="{Binding Position}" SelectedValuePath="Content">
       <ComboBoxItem Content="Top Right"/><ComboBoxItem Content="Top Left"/><ComboBoxItem Content="Bottom Right"/><ComboBoxItem Content="Bottom Left"/>
      </ComboBox>
      <TextBlock Text="Edge spacing" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
      <ComboBox SelectedValue="{Binding EdgeSpacing}" SelectedValuePath="Content"><ComboBoxItem Content="Flush to corner"/><ComboBoxItem Content="Comfortable padding"/></ComboBox>
      <DockPanel Margin="0,18,0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding FontSize, StringFormat={}{0:0} px}" FontSize="11"/><TextBlock Text="Font size" Style="{StaticResource Caption}"/></DockPanel>
      <Slider Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}"/>
      <DockPanel Margin="0,18,0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat={}{0:0%}}" FontSize="11"/><TextBlock Text="Background opacity" Style="{StaticResource Caption}"/></DockPanel>
      <Slider Minimum="0" Maximum="1" TickFrequency="0.01" Value="{Binding Opacity}"/>
      <TextBlock Text="Overlay color" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border x:Name="ColorPreview" Background="White" BorderBrush="#646870" BorderThickness="1" Margin="0,3,6,3"/>
       <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" ToolTip="Hex color, for example #FFFFFF"/>
       <Button Grid.Column="2" Content="Pick" Click="ChooseColor_Click" Margin="8,0,0,0" Padding="12,8"/>
      </Grid>
      <TextBlock Text="Updates every second. No animated effects." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,20,0,0"/>
     </StackPanel></Border>
    </Grid>
    <Expander Header="SENSOR DETAILS" Foreground="#999CA3" FontFamily="Consolas" FontSize="11" Margin="0,16,0,8">
     <TextBlock x:Name="SensorText" Text="Waiting for hardware scan..." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hide settings" Click="Hide_Click" Background="#16181D" Foreground="#DFE1E5" Margin="0,0,10,0"/><Button Content="Save changes" Click="Save_Click"/></StackPanel>
    <TextBlock Text="CTRL + SHIFT + O / toggle overlay" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
