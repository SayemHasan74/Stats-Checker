<Window x:Class="PulseOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Overlay" Height="730" Width="980" MinHeight="620" MinWidth="850"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="PULSE OVERLAY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Performance, without the noise." FontSize="28" FontWeight="SemiBold" Margin="0,3,0,5"/>
                <TextBlock Text="Choose exactly what appears in the horizontal in-game overlay." Foreground="{StaticResource MutedBrush}" FontSize="14"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#202A44" CornerRadius="18" Padding="13,7">
                <TextBlock x:Name="StatusText" Text="Starting sensors..." FontSize="12" Foreground="#C8D3ED"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,25,0,8" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Overlay metrics" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <CheckBox Content="FPS" IsChecked="{Binding ShowFps}"/>
                                <CheckBox Content="CPU usage" IsChecked="{Binding ShowCpuUsage}"/>
                                <CheckBox Content="CPU temperature" IsChecked="{Binding ShowCpuTemp}"/>
                                <CheckBox Content="GPU usage" IsChecked="{Binding ShowGpuUsage}"/>
                                <CheckBox Content="GPU temperature" IsChecked="{Binding ShowGpuTemp}"/>
                                <CheckBox Content="RAM usage" IsChecked="{Binding ShowRam}"/>
                                <CheckBox Content="VRAM usage" IsChecked="{Binding ShowVram}"/>
                                <CheckBox Content="Disk activity" IsChecked="{Binding ShowDisk}"/>
                                <CheckBox Content="Network speed" IsChecked="{Binding ShowNetwork}"/>
                                <CheckBox Content="CPU clock" IsChecked="{Binding ShowCpuClock}"/>
                                <CheckBox Content="GPU clock" IsChecked="{Binding ShowGpuClock}"/>
                                <CheckBox Content="CPU / GPU power" IsChecked="{Binding ShowPower}"/>
                                <CheckBox Content="Clock" IsChecked="{Binding ShowClock}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Behavior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Show overlay" IsChecked="{Binding ShowOverlay}"/>
                            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                            <TextBlock Text="Close sends Pulse Overlay to the notification area." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Screen position" Style="{StaticResource Label}"/>
                            <ComboBox SelectedValue="{Binding Position}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Top Right"/><ComboBoxItem Content="Top Left"/>
                                <ComboBoxItem Content="Bottom Right"/><ComboBoxItem Content="Bottom Left"/>
                            </ComboBox>
                            <TextBlock Text="Edge spacing" Style="{StaticResource Label}" Margin="0,18,0,7"/>
                            <ComboBox SelectedValue="{Binding EdgeSpacing}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Flush to corner"/>
                                <ComboBoxItem Content="Comfortable padding"/>
                            </ComboBox>
                            <TextBlock Text="Font size" Style="{StaticResource Label}" Margin="0,18,0,7"/>
                            <Grid><Slider Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}"/><TextBlock Text="{Binding FontSize, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Margin="0,-20,0,0"/></Grid>
                            <TextBlock Text="Background opacity" Style="{StaticResource Label}" Margin="0,18,0,7"/>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding Opacity}"/>
                            <TextBlock Text="Overlay color" Style="{StaticResource Label}" Margin="0,18,0,7"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ColorPreview" Width="38" Height="34" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBox x:Name="ColorHex" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="110" Padding="8" VerticalContentAlignment="Center"/>
                                <Button Content="Choose" Click="ChooseColor_Click" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Temperature source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock x:Name="SensorText" Text="Waiting for hardware scan..." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock Text="Ctrl+Shift+O toggles the overlay" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hide settings" Click="Hide_Click" Background="#26314E" Foreground="White" Margin="0,0,10,0"/>
                <Button Content="Save changes" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
