<Window x:Class="PulseOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseOverlay"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" Focusable="False"
        UseLayoutRounding="True">
    <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly"><local:MetricStrip x:Name="Strip"/></Viewbox>
</Window>
